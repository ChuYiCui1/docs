  "keyFeatures": [
    "38+ data endpoints covering market, financial, real-time, news, and reference data",
    "Returns pandas DataFrames — same convention as Tushare",
    "Real-time intraday quote snapshots for up to 200 symbols per call",
    "10+ years of historical OHLCV and financial data",
    "Stock Connect (HSGT) northbound and southbound capital flow tracking",
    "200+ technical indicators with adjusted price variants (bfq/qfq/hfq)",
    "Chinese financial news flashes from CLS, Jin10, and Sina",
    "Secure API key authentication via X-API-Key header",
    "Unified v2 API with suffixed symbol codes (e.g. 000001.SZ)",
    "Context-manager support for safe resource cleanup"
  ],
